<bpmndi:BPMNShape id="Gw_manual_di" bpmnElement="Gw_manual"><dc:Bounds x="1006" y="390" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="976.0" y="446" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_manual_di" bpmnElement="Task_manual"><dc:Bounds x="969" y="229" width="124" height="72" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_list_di" bpmnElement="Task_list"><dc:Bounds x="1134" y="379" width="124" height="72" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"><dc:Bounds x="1343" y="97" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1306.0" y="63" width="110" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="224" y="115" /><di:waypoint x="309" y="115" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="433" y="115" /><di:waypoint x="536" y="115" /><di:waypoint x="536" y="379" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="598" y="415" /><di:waypoint x="676" y="415" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="701" y="390" /><di:waypoint x="701" y="151" /><bpmndi:BPMNLabel><dc:Bounds x="705" y="252" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="701" y="79" /><di:waypoint x="701" y="54" /><di:waypoint x="371" y="54" /><di:waypoint x="371" y="79" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="726" y="415" /><di:waypoint x="804" y="415" /><bpmndi:BPMNLabel><dc:Bounds x="769" y="397" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
