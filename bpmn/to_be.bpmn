<bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1031" y="390" /><di:waypoint x="1031" y="301" /><bpmndi:BPMNLabel><dc:Bounds x="1035" y="328" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1093" y="265" /><di:waypoint x="1196" y="265" /><di:waypoint x="1196" y="379" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1056" y="415" /><di:waypoint x="1134" y="415" /><bpmndi:BPMNLabel><dc:Bounds x="1099" y="397" width="40" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1258" y="415" /><di:waypoint x="1361" y="415" /><di:waypoint x="1361" y="133" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
